@page "/users"
@inject MockDataService Data
@inject CurrentUserService CurrentUser
@implements IDisposable

<PageTitle>Users &mdash; Pulse</PageTitle>

<div class="p-6 space-y-6">
    <div class="flex items-center justify-between flex-wrap gap-3">
        <div>
            <h1 class="text-2xl font-semibold">Users</h1>
            <p class="text-muted-foreground text-sm mt-1">@Data.TotalUsers total users in your workspace.</p>
        </div>

        @if (CurrentUser.CanManageUsers)
        {
            <button class="px-4 py-2 rounded-md bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-700 transition-colors">
                + Invite user
            </button>
        }
        else
        {
            <span class="text-xs text-muted-foreground italic">Viewers can't manage users</span>
        }
    </div>

    <div class="rounded-xl border border-border bg-card shadow-sm overflow-hidden">

        <!-- Search + page size -->
        <div class="p-4 border-b border-border flex items-center justify-between gap-3 flex-wrap">
            <div class="relative w-full sm:w-72">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground text-sm">&#128269;</span>
                <input @bind="_searchTerm" @bind:event="oninput"
                       placeholder="Search by name or email..."
                       class="w-full pl-9 pr-3 py-2 text-sm rounded-md border border-border bg-background outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>

            <div class="flex items-center gap-2 text-sm text-muted-foreground">
                <span>Rows per page</span>
                <select @bind="_pageSize" class="rounded-md border border-border bg-background px-2 py-1.5 outline-none focus:ring-2 focus:ring-indigo-500">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                </select>
            </div>
        </div>

        <!-- Table -->
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-left border-b border-border bg-muted/40">
                        <th class="p-3"><SortHeader Label="Name" Column="name" Current="_sortColumn" Ascending="_sortAscending" OnSort="Sort" /></th>
                        <th class="p-3"><SortHeader Label="Email" Column="email" Current="_sortColumn" Ascending="_sortAscending" OnSort="Sort" /></th>
                        <th class="p-3"><SortHeader Label="Role" Column="role" Current="_sortColumn" Ascending="_sortAscending" OnSort="Sort" /></th>
                        <th class="p-3"><SortHeader Label="Status" Column="status" Current="_sortColumn" Ascending="_sortAscending" OnSort="Sort" /></th>
                        <th class="p-3"><SortHeader Label="Joined" Column="joined" Current="_sortColumn" Ascending="_sortAscending" OnSort="Sort" /></th>
                        @if (CurrentUser.CanManageUsers)
                        {
                            <th class="p-3 text-right">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in PagedUsers)
                    {
                        <tr class="border-b border-border/50 last:border-0 hover:bg-muted/30 transition-colors">
                            <td class="p-3">
                                <div class="flex items-center gap-2">
                                    <div class="h-8 w-8 rounded-full bg-indigo-600/10 text-indigo-600 flex items-center justify-center text-xs font-semibold shrink-0">
                                        @user.Avatar
                                    </div>
                                    <span class="font-medium">@user.Name</span>
                                </div>
                            </td>
                            <td class="p-3 text-muted-foreground">@user.Email</td>
                            <td class="p-3"><Badge Text="@user.Role.ToString()" ColorClass="@RoleBadgeClass(user.Role)" /></td>
                            <td class="p-3"><Badge Text="@user.Status.ToString()" ColorClass="@StatusBadgeClass(user.Status)" /></td>
                            <td class="p-3 text-muted-foreground">@user.JoinedOn.ToString("MMM d, yyyy")</td>
                            @if (CurrentUser.CanManageUsers)
                            {
                                <td class="p-3 text-right">
                                    <button @onclick="() => RemoveUser(user.Id)"
                                            class="text-xs text-red-600 hover:underline">
                                        Remove
                                    </button>
                                </td>
                            }
                        </tr>
                    }

                    @if (!PagedUsers.Any())
                    {
                        <tr>
                            <td colspan="6" class="p-8 text-center text-muted-foreground">No users match "@_searchTerm".</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="p-4 border-t border-border flex items-center justify-between text-sm">
            <span class="text-muted-foreground">
                Showing @(FilteredUsers.Count == 0 ? 0 : (_page - 1) * _pageSize + 1)&ndash;@Math.Min(_page * _pageSize, FilteredUsers.Count) of @FilteredUsers.Count
            </span>
            <div class="flex items-center gap-1">
                <button @onclick="() => GoToPage(_page - 1)" disabled="@(_page <= 1)"
                        class="px-3 py-1.5 rounded-md border border-border disabled:opacity-40 hover:bg-muted transition-colors">
                    Prev
                </button>
                <span class="px-2 text-muted-foreground">Page @_page of @Math.Max(TotalPages, 1)</span>
                <button @onclick="() => GoToPage(_page + 1)" disabled="@(_page >= TotalPages)"
                        class="px-3 py-1.5 rounded-md border border-border disabled:opacity-40 hover:bg-muted transition-colors">
                    Next
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private string _searchTerm = "";
    private string _sortColumn = "name";
    private bool _sortAscending = true;
    private int _page = 1;
    private int _pageSize = 10;

    private List<AppUser> AllUsers => Data.GetUsers().ToList();

    private List<AppUser> FilteredUsers
    {
        get
        {
            var query = AllUsers.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim();
                query = query.Where(u =>
                    u.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    u.Email.Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            query = _sortColumn switch
            {
                "email" => _sortAscending ? query.OrderBy(u => u.Email) : query.OrderByDescending(u => u.Email),
                "role" => _sortAscending ? query.OrderBy(u => u.Role) : query.OrderByDescending(u => u.Role),
                "status" => _sortAscending ? query.OrderBy(u => u.Status) : query.OrderByDescending(u => u.Status),
                "joined" => _sortAscending ? query.OrderBy(u => u.JoinedOn) : query.OrderByDescending(u => u.JoinedOn),
                _ => _sortAscending ? query.OrderBy(u => u.Name) : query.OrderByDescending(u => u.Name),
            };

            return query.ToList();
        }
    }

    private int TotalPages => (int)Math.Ceiling(FilteredUsers.Count / (double)_pageSize);

    private List<AppUser> PagedUsers => FilteredUsers
        .Skip((_page - 1) * _pageSize)
        .Take(_pageSize)
        .ToList();

    protected override void OnInitialized()
    {
        CurrentUser.OnChange += StateHasChanged;
    }

    private void Sort(string column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
        _page = 1;
    }

    private void GoToPage(int page)
    {
        if (page < 1 || page > TotalPages) return;
        _page = page;
    }

    private void RemoveUser(int id)
    {
        if (!CurrentUser.CanManageUsers) return;
        Data.DeleteUser(id);
    }

    private string RoleBadgeClass(UserRole role) => role switch
    {
        UserRole.Admin => "bg-indigo-100 text-indigo-700 dark:bg-indigo-500/10 dark:text-indigo-400",
        UserRole.Editor => "bg-blue-100 text-blue-700 dark:bg-blue-500/10 dark:text-blue-400",
        _ => "bg-slate-100 text-slate-600 dark:bg-slate-500/10 dark:text-slate-400"
    };

    private string StatusBadgeClass(UserStatus status) => status switch
    {
        UserStatus.Active => "bg-emerald-100 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400",
        UserStatus.Invited => "bg-amber-100 text-amber-700 dark:bg-amber-500/10 dark:text-amber-400",
        UserStatus.Suspended => "bg-red-100 text-red-700 dark:bg-red-500/10 dark:text-red-400",
        _ => "bg-slate-100 text-slate-600"
    };

    public void Dispose()
    {
        CurrentUser.OnChange -= StateHasChanged;
    }
}
