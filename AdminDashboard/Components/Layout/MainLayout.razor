@inherits LayoutComponentBase
@inject ThemeService ThemeService
@inject CurrentUserService CurrentUser
@inject IJSRuntime JS
@implements IDisposable

<div class="flex h-screen overflow-hidden">

    <!-- Sidebar -->
    <aside class="@($"flex flex-col shrink-0 border-r border-border bg-card transition-all duration-200 {(_sidebarOpen ? "w-64" : "w-16")}")">
        <div class="flex items-center gap-2 h-16 px-4 border-b border-border">
            <div class="h-8 w-8 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-bold shrink-0">P</div>
            @if (_sidebarOpen)
            {
                <span class="font-semibold text-lg tracking-tight">Pulse</span>
            }
        </div>

        <nav class="flex-1 px-2 py-4 space-y-1">
            <NavMenu SidebarOpen="_sidebarOpen" />
        </nav>

        <button @onclick="ToggleSidebar"
                class="m-2 flex items-center justify-center h-9 rounded-md text-sm text-muted-foreground hover:bg-muted transition-colors">
            @(_sidebarOpen ? "\u00ab Collapse" : "\u00bb")
        </button>
    </aside>

    <!-- Main column -->
    <div class="flex flex-col flex-1 overflow-hidden">

        <!-- Topbar -->
        <header class="h-16 shrink-0 border-b border-border flex items-center justify-between px-6 bg-card">
            <div>
                <h1 class="text-sm font-medium text-muted-foreground">Welcome back,</h1>
                <p class="font-semibold">@CurrentUser.Name</p>
            </div>

            <div class="flex items-center gap-3">
                <!-- Role switcher (demo of role-based access; a real app reads this from auth claims) -->
                <label class="text-xs text-muted-foreground hidden sm:block">Viewing as</label>
                <select class="text-sm rounded-md border border-border bg-background px-2 py-1.5 outline-none focus:ring-2 focus:ring-indigo-500"
                        value="@CurrentUser.Role" @onchange="OnRoleChanged">
                    <option value="Admin">Admin</option>
                    <option value="Editor">Editor</option>
                    <option value="Viewer">Viewer</option>
                </select>

                <button @onclick="ToggleDarkMode"
                        class="h-9 w-9 rounded-md border border-border flex items-center justify-center hover:bg-muted transition-colors"
                        title="Toggle dark mode">
                    @(ThemeService.IsDarkMode ? "\u2600\ufe0f" : "\ud83c\udf19")
                </button>

                <div class="h-9 w-9 rounded-full bg-indigo-600 text-white flex items-center justify-center text-sm font-semibold">
                    @Initials
                </div>
            </div>
        </header>

        <!-- Page content -->
        <main class="flex-1 overflow-y-auto bg-background">
            @Body
        </main>
    </div>
</div>

@code {
    private bool _sidebarOpen = true;

    private string Initials =>
        string.Concat(CurrentUser.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(p => char.ToUpperInvariant(p[0])));

    protected override void OnInitialized()
    {
        ThemeService.OnChange += StateHasChanged;
        CurrentUser.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Sync server-side state with whatever the browser already applied
            // (OS preference), so the sun/moon toggle icon matches reality.
            var prefersDark = await JS.InvokeAsync<bool>("pulseTheme.prefersDark");
            if (prefersDark != ThemeService.IsDarkMode)
            {
                ThemeService.SetDarkMode(prefersDark);
            }
        }
    }

    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;

    private async Task ToggleDarkMode()
    {
        ThemeService.Toggle();
        await JS.InvokeVoidAsync("pulseTheme.setDarkMode", ThemeService.IsDarkMode);
    }

    private void OnRoleChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<UserRole>(e.Value?.ToString(), out var role))
        {
            CurrentUser.SetRole(role);
        }
    }

    public void Dispose()
    {
        ThemeService.OnChange -= StateHasChanged;
        CurrentUser.OnChange -= StateHasChanged;
    }
}
