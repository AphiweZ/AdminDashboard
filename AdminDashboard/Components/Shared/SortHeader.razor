<button @onclick="() => OnSort.InvokeAsync(Column)"
        class="flex items-center gap-1 font-medium hover:text-foreground transition-colors">
    @Label
    @if (Current == Column)
    {
        <span class="text-xs">@(Ascending ? "\u2191" : "\u2193")</span>
    }
</button>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Column { get; set; } = "";
    [Parameter] public string Current { get; set; } = "";
    [Parameter] public bool Ascending { get; set; }
    [Parameter] public EventCallback<string> OnSort { get; set; }
}
